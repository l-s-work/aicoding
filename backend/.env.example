# 应用配置
APP_NAME="AI电商平台"
DEBUG=true

# JWT 密钥配置（生产环境请使用强密钥）
JWT_SECRET_KEY=your-super-secret-jwt-key-change-this-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=120
REFRESH_TOKEN_EXPIRE_DAYS=7

# 数据库配置
DATABASE_URL=sqlite+aiosqlite:///./ecommerce.db

# OpenAI API 配置
OPENAI_API_KEY=your-openai-api-key-here
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_BASE_URL=https://api.openai.com/v1

# 千问 Embedding 配置（可选；配置后 embedding 会优先使用千问）
QWEN_API_KEY=your-qwen-api-key-here
QWEN_EMBEDDING_MODEL=qwen3-vl-embedding
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_MULTIMODAL_EMBEDDING_URL=https://dashscope.aliyuncs.com/api/v1/services/embeddings/multimodal-embedding/multimodal-embedding
QWEN_EMBEDDING_DIMENSION=1024

# CORS 配置（开发环境）
CORS_ORIGINS=http://localhost:5174,http://127.0.0.1:5174
